# Dependencies
node_modules/
**/node_modules/

# Environment Variables & Secrets (Keep all keys secure)
.env
.env.*
*.env
**/.env
**/.env.*
!*.env.example
!**/.env.example

# Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.id_rsa
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
serviceAccount*.json
service-account*.json
*.keystore
secrets.*

# Sensitive Documents, Backups & Local Data
uploads/
**/uploads/
documents/
**/documents/
docs_private/
**/docs_private/
attachments/
**/attachments/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
*.csv
*.xlsx
*.pdf
*.docx
*.doc

# Builds & Outputs
build/
dist/
**/build/
**/dist/

# Logs
logs/
**/logs/
*.log

# System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.history/
